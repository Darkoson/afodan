rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function role() { return profile().role; }
    function active() { return profile().status == 'active'; }
    function staff() { return hasProfile() && active(); }
    function isAdmin()   { return staff() && role() == 'admin'; }
    function isManager() { return staff() && role() == 'manager'; }
    function seesAll()   { return isAdmin() || isManager(); }          // read scope
    function isWriter()  { return staff() && role() in ['manager','collector']; } // admin is read-only

    // is a given collector's day locked (approved)?
    function dayApproved(collectorId, date) {
      return exists(/databases/$(database)/documents/closures/$(collectorId + '_' + date)) &&
        get(/databases/$(database)/documents/closures/$(collectorId + '_' + date)).data.status == 'approved';
    }

    // ---- users: only admin manages; any signed-in user can read (for role lookups/UI) ----
    match /users/{uid} {
      allow read:   if signedIn();
      allow create, update, delete: if isAdmin();
      // one-time bootstrap: the designated admin account creates its own admin profile
      allow create: if signedIn() && request.auth.uid == uid
                    && request.auth.token.email == 'admin@afodan.app'
                    && request.resource.data.role == 'admin';
    }

    // ---- clients: collectors see/write only their own; managers write all; admin read-only ----
    match /clients/{id} {
      allow read:   if staff() && (seesAll() || resource.data.ownerId == request.auth.uid);
      allow create: if isWriter() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isWriter() && (isManager() || resource.data.ownerId == request.auth.uid);
      allow delete: if isWriter() && (isManager() || resource.data.ownerId == request.auth.uid);
    }

    // ---- plans / cycles: staff read, writers write ----
    match /plans/{id}  { allow read: if staff(); allow write: if isWriter(); }
    match /cycles/{id} { allow read: if staff(); allow write: if isWriter(); }

    // ---- collections: writers only, and locked once the day is approved (server-enforced) ----
    match /collections/{id} {
      allow read:   if staff();
      allow create: if isWriter() &&
                    !dayApproved(request.resource.data.collectorId, request.resource.data.date);
      allow update, delete: if isWriter() &&
                    !dayApproved(resource.data.collectorId, resource.data.date);
    }

    // ---- withdrawals ----
    match /withdrawals/{id} { allow read: if staff(); allow write: if isWriter(); }

    // ---- closures: writers submit; only a manager (not the owner) approves; never deleted ----
    match /closures/{id} {
      allow read:   if staff();
      allow create: if isWriter();
      allow update: if (isWriter() && request.resource.data.status != 'approved')
                    || (isManager() && resource.data.collectorId != request.auth.uid);
      allow delete: if false;
    }

    // ---- business settings: admin writes, all staff read ----
    match /settings/{id} { allow read: if staff(); allow write: if isAdmin(); }
  }
}
